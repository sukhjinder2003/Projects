# Copy this file to ".env" (copy .env.example .env) and edit the values.
# Everything here is OPTIONAL. Without an API key the app uses its built-in
# template-based script generator.

# Anthropic (Claude) API key for AI-written scripts and captions.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for script generation (any Claude model your key can access).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Seconds to wait for the AI API before falling back to templates.
LLM_TIMEOUT=30

# Video frame rate (24 is a good balance of smoothness and render speed).
VIDEO_FPS=24

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
